        },
        "inline:actorManager#entry[0]": {
          "id": "inline:actorManager#entry[0]",
          "code": "export default enqueueActions(({ context, enqueue }) => {\n        Object.entries(context.lazyActorConfig).forEach(([id, actorConfig]) => {\n            const { loadingStrategy, input } = actorConfig;\n            if (loadingStrategy !== \"eager\")\n                return;\n            if (typeof input === \"function\")\n                throw new Error(\"Lazy actor config input cannot be a function when loading strategy is eager\");\n            enqueue.raise({ type: \"actor.start\", id, input });\n        });\n    })",
          "name": "inline:actorManager#entry[0]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#actor.stop[-1]#transition[0]": {
          "id": "inline:actorManager#actor.stop[-1]#transition[0]",
          "code": "export default log(({ event }) => `Stopped ${event.id} actor`)",
          "name": "Unnamed log",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#actor.stop[-1]#transition[1]": {
          "id": "inline:actorManager#actor.stop[-1]#transition[1]",
          "code": "export default stopChild(({ event }) => event.id)",
          "name": "inline:actorManager#actor.stop[-1]#transition[1]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#actor.start[-1]#transition[0]": {
          "id": "inline:actorManager#actor.start[-1]#transition[0]",
          "code": "export default log(({ event }) => `Actor ${event.id} not in lazyActorConfig`)",
          "name": "Unnamed log",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#actor.start[-1]#transition[1]": {
          "id": "inline:actorManager#actor.start[-1]#transition[1]",
          "code": "export default enqueueActions(({ context, enqueue, event }) => {\n                        const { path, loader } = assertExists(context.lazyActorConfig[event.id]);\n                        const { id, input = {} } = event;\n                        enqueue.spawnChild(\"lazyActorLoader\", {\n                            input: {\n                                id,\n                                actorLogicPath: path,\n                                loader,\n                                actorInput: input,\n                            },\n                            id: `import.${id}`,\n                            systemId: id,\n                        });\n                    })",
          "name": "inline:actorManager#actor.start[-1]#transition[1]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#xstate.error.actor.*[-1]#transition[0]": {
          "id": "inline:actorManager#xstate.error.actor.*[-1]#transition[0]",
          "code": "export default enqueueActions(({ enqueue, event, check }) => {\n                    const id = event.type.split(\".\")[3];\n                    const { error } = event as unknown as EventObject & {\n                        error: Error;\n                    };\n                    if (check(\"isDebugMode\"))\n                        console.error(error);\n                    enqueue(log(`${id} actor ${error.toString()}`, \"ACTORMANAGERERROR\"));\n                    enqueue.stopChild(id);\n                    enqueue({\n                        type: \"updateActorStatus\",\n                        params: { id, status: \"error\" },\n                    });\n                })",
          "name": "inline:actorManager#xstate.error.actor.*[-1]#transition[0]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#xstate.done.actor.import.*[-1]#transition[0]": {
          "id": "inline:actorManager#xstate.done.actor.import.*[-1]#transition[0]",
          "code": "export default enqueueActions(({ enqueue, event }) => {\n                    const id = event.type.split(\".\")[4];\n                    const { actorLogic, loaderData, actorInput } = event.output;\n                    const input = typeof actorInput === \"function\" ? actorInput(loaderData) : actorInput;\n                    enqueue(log(`Started ${id} actor`));\n                    enqueue.stopChild(`import.${id}`);\n                    // IDEA: Figure out how to type this\n                    // @ts-expect-error need to figure out how to type this\n                    enqueue.spawnChild(actorLogic, {\n                        id,\n                        systemId: id,\n                        input,\n                    });\n                    enqueue({\n                        type: \"updateActorStatus\",\n                        params: { id, status: \"running\" },\n                    });\n                })",
          "name": "inline:actorManager#xstate.done.actor.import.*[-1]#transition[0]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#xstate.done.actor.import.*[-1]#transition[1]": {
          "id": "inline:actorManager#xstate.done.actor.import.*[-1]#transition[1]",
          "code": "export default enqueueActions(({ enqueue, event, system }) => {\n                    const id = event.type.split(\".\")[4];\n                    const { eventQueue, eventListeners } = event.output;\n                    const actor = system.get(id) as AnyActorRef;\n                    eventListeners.forEach((callbacks, key) => {\n                        callbacks.forEach((callback) => actor.on(key, callback));\n                    });\n                    eventQueue.forEach((queuedEvent) => {\n                        enqueue.sendTo(actor, queuedEvent);\n                    });\n                })",
          "name": "inline:actorManager#xstate.done.actor.import.*[-1]#transition[1]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager#xstate.error.actor.import.*[-1]#transition[0]": {
          "id": "inline:actorManager#xstate.error.actor.import.*[-1]#transition[0]",
          "code": "export default enqueueActions(({ check, enqueue, event }) => {\n                const id = event.type.split(\".\")[4];\n                const { error } = event as unknown as EventObject & {\n                    error: Error;\n                };\n                if (check(\"isDebugMode\"))\n                    console.error(error);\n                enqueue(log(`import ${id} actor ${error.toString()}`, \"ACTORMANAGERERROR\"));\n                enqueue.stopChild(`import.${id}`);\n                enqueue({\n                    type: \"updateActorStatus\",\n                    params: { id, status: \"error\" },\n                });\n            })",
          "name": "inline:actorManager#xstate.error.actor.import.*[-1]#transition[0]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "inline:actorManager.configNotLoaded#CONFIG_FOR_LOADING_STRATEGY[-1]#transition[0]": {
          "id": "inline:actorManager.configNotLoaded#CONFIG_FOR_LOADING_STRATEGY[-1]#transition[0]",
          "code": "export default enqueueActions(({ context, enqueue, event }) => {\n    Object.entries(context.lazyActorConfig).forEach(([id, actorConfig]) => {\n        if (actorConfig.loadingStrategy !== \"fromConfig\")\n            return;\n        const { loadingCondition, input: actorConfigInput } = actorConfig;\n        if (!loadingCondition(event.config))\n            return;\n        const input = actorConfigInput?.(event.config);\n        enqueue.raise({ type: \"actor.start\", id, input });\n    });\n})",
          "name": "inline:actorManager.configNotLoaded#CONFIG_FOR_LOADING_STRATEGY[-1]#transition[0]",
          "type": "action",
          "schema": {
            "type": "object",
            "properties": {}
