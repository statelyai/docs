      "actors": {
        "dropHandler": {
          "id": "dropHandler",
          "code": "export default fromPromise(async (({input})) => {\n  await zMove(input.motionClient, input.armClient, 240)\n  await grab(input.boardClient, input.gripperClient)\n  await delay(1000)\n  await zMove(input.motionClient, input.armClient, input.moveHeight)\n  await home(input.motionClient, input.armClient)\n  await delay(1000)\n  await release(input.boardClient, input.gripperClient)\n})\n",
          "kind": "named",
          "name": "dropHandler",
          "type": "actor",
          "input": {
            "type": "object",
            "properties": {}
          },
          "output": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "moveHandler": {
          "id": "moveHandler",
          "code": "export default fromPromise(async ({ input }) => {\n  if (input.target == \"quadrant\") {\n    await moveToQuadrant(input.motionClient, input.armClient, input.x, input.y)\n  }\n  if (input.target == \"planar\") {\n    await inPlanarMove(input.motionClient, input.armClient, input.x, input.y)\n  }\n})\n",
          "kind": "named",
          "name": "moveHandler",
          "type": "actor",
          "input": {
            "type": "object",
            "properties": {}
          },
          "output": {
            "type": "object",
            "properties": {}
          },
          "imports": []
        },
        "createRobotClient": {
          "id": "createRobotClient",
          "code": "export default fromPromise(\n  async ({ input }) => {\n    const credential = {\n      type: \"api-key\",\n      payload: input.apiKey,\n    }\n\n    //This is the host address of the main part of your robot.\n    const host = input.locationAddress\n\n    return createRobotClient({\n      host,\n      credential,\n      authEntity: input.apiKeyId,\n      signalingAddress:\n        \"https://app.viam.com:443\",\n    })\n  },\n)\n",
          "kind": "named",
          "name": "createRobotClient",
          "type": "actor",
          "input": {
            "type": "object",
            "properties": {}
